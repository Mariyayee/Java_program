import java.util.*;
public class Main{
    static int countvowels(String s){
        int count = 0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(c=='a'||c=='e'||c=='i'||c=='o'||'u'){
                count++;
            }
        }
        return count;
    }
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextInt();
        System.out.println(countvowels(s));
    } 
}
