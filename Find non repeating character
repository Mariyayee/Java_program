import java.util.*;
private static Character findnonrepeatingchar(String s){
    if(s.length() <=1){
        return null;
    }
    int[] arr=new int[256];
    for(int i=0;i<s.length();i++){
        arr[s.charAt(i)]++;
    }
    for(int i=0;i<s.length();i++){
        if(arr[s.charAt(i)]==1){
            return s.charAt(i); 
        }
    }
    return null;
    
}
public static void main(String[] args){
    String s="abcab";
    System.out.println(findnonrepeatingchar(s));
}
