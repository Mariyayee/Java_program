//1.Identify the Nature of a Number

import java.util.*;
public class Main {
    public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
    int a=sc.nextInt();
    if(a==0){
      System.out.println("ZERO");
    }else if(a>0){
      System.out.println("POSITIVE");
    }else{
      System.out.println("NEGATIVE");
    }
  }
}

