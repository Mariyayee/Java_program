//3.Smallest of Four Numbers

import java.util.*;
public class Main {
    public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);
    int a=sc.nextInt();
    int b=sc.nextInt();
    int c=sc.nextInt();
    int d=sc.nextInt();
    if(a<b && a<c && a<d){
      System.out.println(a);
    }else if(b<a && b<c && b<d){
      System.out.println(b);
    }else{
      System.out.println(c);
    }
  }
}

